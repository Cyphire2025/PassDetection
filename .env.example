# ============================================================
# Global Connects Dashboard — Environment Variables Template
# ============================================================
# Copy this file to .env and populate all values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
APP_DEBUG=true
APP_VERSION=1.0.0
APP_REVISION=unknown                      # 7-64 lowercase hex source commit
APP_NAME="Global Connects Dashboard"
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","https://192.168.1.7"]

# ── API ──────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
WEB_CONCURRENCY=4
WORKER_CONCURRENCY=2
EMAIL_WORKER_CONCURRENCY=2
EMAIL_AI_WORKER_CONCURRENCY=2

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=passdetection
POSTGRES_USER=passdetection_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Each process owns one pool. Compose selects `api` for Gunicorn and `worker`
# for Celery/Beat; do not set one large profile for every service.
POSTGRES_POOL_PROFILE=api
POSTGRES_API_POOL_SIZE=8
POSTGRES_API_MAX_OVERFLOW=2
POSTGRES_WORKER_POOL_SIZE=1
POSTGRES_WORKER_MAX_OVERFLOW=0
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_POOL_RECYCLE_SECONDS=1800
# Must match the real server. Defaults reserve 10 connections for migrations,
# administration, probes, and failure recovery. The checked default deployment
# can claim 40 API + 41 background connections, leaving nine additional spare
# application slots inside the 90-connection usable budget.
POSTGRES_SERVER_MAX_CONNECTIONS=100
POSTGRES_RESERVED_CONNECTIONS=10
POSTGRES_API_CONNECTION_BUDGET=80

# Assembled automatically by the app — do not set manually:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# Distributed public-upload guards. Initial uploads allow 100 users behind one
# NAT to start together, while repeated requests from one session stay bounded.
PUBLIC_UPLOAD_BOOTSTRAP_SESSION_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOAD_BOOTSTRAP_AGGREGATE_RATE_LIMIT_PER_MINUTE=600
PUBLIC_UPLOAD_SESSION_RATE_LIMIT_PER_MINUTE=6
PUBLIC_UPLOAD_AGGREGATE_RATE_LIMIT_PER_MINUTE=180
PUBLIC_UPLOAD_FOLLOWUP_SESSION_RATE_LIMIT_PER_MINUTE=120
PUBLIC_UPLOAD_FOLLOWUP_AGGREGATE_RATE_LIMIT_PER_MINUTE=6000
PUBLIC_UPLOAD_RATE_LIMIT_REQUIRE_REDIS=true

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
# Set true only when serving over HTTPS. Production must be true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
JWT_LOGIN_LOCKOUT_MAX_ATTEMPTS=5
JWT_LOGIN_LOCKOUT_WINDOW_SECONDS=900
JWT_LOGIN_LOCKOUT_SECONDS=900
JWT_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── GC Mobile App ──────────────────────────────────────────────
# Keep disabled until migration 0069 is applied and GC groups are explicitly
# enabled. The development OTP provider must never be used in production.
MOBILE_ENABLED=false
# Required when MOBILE_ENABLED=true in production. Use an independent,
# cryptographically random secret of at least 32 UTF-8 bytes.
MOBILE_JWT_SECRET_KEY=
MOBILE_JWT_ISSUER=passdetection
MOBILE_JWT_AUDIENCE=gc-mobile
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOBILE_REFRESH_TOKEN_EXPIRE_DAYS=30
# Required whenever the mobile API is enabled outside development. The private
# value is unpadded base64url PKCS8 DER for one Ed25519 key and belongs only in
# the backend secret manager. Public key values are unpadded base64url raw
# 32-byte Ed25519 keys; keep at most five during controlled key rotation.
MOBILE_OFFLINE_LEASE_ACTIVE_KID=
MOBILE_OFFLINE_LEASE_PRIVATE_KEY_B64=
MOBILE_OFFLINE_LEASE_PUBLIC_KEYS_JSON=
MOBILE_OFFLINE_LEASE_ISSUER=passdetection-mobile-offline
MOBILE_OFFLINE_LEASE_AUDIENCE=gc-mobile-offline
MOBILE_OFFLINE_LEASE_TTL_MINUTES=720
MOBILE_OTP_PROVIDER=disabled              # disabled | development | whatsapp
MOBILE_OTP_DEVELOPMENT_CODE=
MOBILE_OTP_TTL_SECONDS=300
MOBILE_OTP_DELIVERY_TIMEOUT_SECONDS=10
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_PHONE_LIMIT_PER_HOUR=10
MOBILE_OTP_IP_LIMIT_PER_HOUR=30
MOBILE_OTP_REQUIRE_REDIS=true
MOBILE_SYNC_PAGE_SIZE=200
MOBILE_SYNC_MAX_INCREMENTAL_CHANGES=10000
MOBILE_MAX_GROUP_PASSENGERS=10000
MOBILE_MAX_ATTENDANCE_SESSIONS_PER_GROUP=10000
# Enable only after Redis and the reverse proxy WebSocket upgrade path pass the
# checks in docs/MOBILE_REALTIME.md. Required mode fails startup/readiness on a
# Redis outage; false exposes an explicit cursor-only degraded health signal.
MOBILE_REALTIME_ENABLED=false
MOBILE_REALTIME_REQUIRE_REDIS=true
MOBILE_REALTIME_HEARTBEAT_SECONDS=20
MOBILE_REALTIME_IDLE_TIMEOUT_SECONDS=65
MOBILE_REALTIME_AUTHORIZATION_REFRESH_SECONDS=60
MOBILE_REALTIME_MAX_CONNECTIONS=5000
MOBILE_REALTIME_MAX_AUTHENTICATING_CONNECTIONS=32
# Deployment-wide Redis leases. The 1,000 default is an admission setting, not
# evidence that a production environment has passed its external load gate.
MOBILE_REALTIME_GLOBAL_MAX_CONNECTIONS=1000
MOBILE_REALTIME_GLOBAL_MAX_AUTHENTICATING_CONNECTIONS=32
MOBILE_REALTIME_LEASE_TTL_SECONDS=90
MOBILE_REALTIME_LEASE_RENEW_INTERVAL_SECONDS=20
MOBILE_REALTIME_MAX_CONNECTIONS_PER_SESSION=3
MOBILE_REALTIME_MAX_TRIPS_PER_CONNECTION=500
MOBILE_REALTIME_MAX_PENDING_TRIPS_PER_CONNECTION=64
MOBILE_REALTIME_PUBLISH_QUEUE_SIZE=20000
MOBILE_REALTIME_SEND_TIMEOUT_SECONDS=5
# Disabled is backward-compatible. Monitor records server verdict result codes
# without blocking; enforce fails closed only for protected high-risk actions.
MOBILE_APP_INTEGRITY_MODE=disabled
MOBILE_APP_INTEGRITY_CHALLENGE_TTL_SECONDS=120
MOBILE_APP_INTEGRITY_REQUIRE_REDIS=true
MOBILE_APP_INTEGRITY_PROOF_MAX_BYTES=32768
MOBILE_PLAY_INTEGRITY_PACKAGE_NAME=com.globalconnects.groupcompanion
# Canonical JSON array of SHA-256 base64url Play signing certificate digests.
MOBILE_PLAY_INTEGRITY_ALLOWED_CERTIFICATE_DIGESTS_JSON=
MOBILE_PLAY_INTEGRITY_REQUIRE_LICENSED=true
MOBILE_PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
MOBILE_PLAY_INTEGRITY_TIMEOUT_SECONDS=8
# Public Apple application identity and exact iOS 27+ distribution policy.
# App Store builds normally use validation category 4; TestFlight uses 2 and
# approved enterprise/ad-hoc distribution uses 5. Bundle versions are exact
# CFBundleVersion/build-number values. Add the incoming version before rollout
# and remove retired versions after the enforced minimum-version window. Leave
# the rollout acknowledgement false while iOS 16.4-26 clients remain eligible
# for the protected action; production enforcement refuses to start otherwise.
MOBILE_APP_ATTEST_TEAM_ID=
MOBILE_APP_ATTEST_BUNDLE_ID=com.globalconnects.groupcompanion
MOBILE_APP_ATTEST_ENVIRONMENT=development
MOBILE_APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES_JSON=[4]
MOBILE_APP_ATTEST_ALLOWED_BUNDLE_VERSIONS_JSON=["1"]
MOBILE_APP_ATTEST_IOS27_EXTENSION_ROLLOUT_CONFIRMED=false
MOBILE_ADMIN_PAGE_SIZE=50
MOBILE_COMMON_DOCUMENT_MAX_BYTES=26214400
MOBILE_PERSONAL_DOCUMENT_MAX_BYTES=26214400
MOBILE_DOCUMENT_GRANT_TTL_SECONDS=60
MOBILE_PUSH_PROVIDER=disabled             # disabled | expo
MOBILE_PUSH_ACCESS_TOKEN=
MOBILE_PUSH_BATCH_SIZE=100
MOBILE_PUSH_TIMEOUT_SECONDS=10
MOBILE_PUSH_DISPATCH_INTERVAL_SECONDS=5
MOBILE_PUSH_MAX_SEND_ATTEMPTS=5
MOBILE_PUSH_RETRY_BASE_SECONDS=5
MOBILE_PUSH_RECEIPT_BATCH_SIZE=1000
MOBILE_PUSH_RECEIPT_INITIAL_DELAY_SECONDS=900
MOBILE_PUSH_RECEIPT_POLL_INTERVAL_SECONDS=60
MOBILE_PUSH_RECEIPT_MAX_ATTEMPTS=8
MOBILE_PUSH_RECEIPT_MAX_AGE_HOURS=23
MOBILE_PUSH_COUNTDOWN_SCAN_INTERVAL_SECONDS=900
# Groups currently carry a date, not a departure timestamp. This IANA timezone
# and local hour define the push-only 3/2/1-day countdown delivery instant.
MOBILE_PUSH_COUNTDOWN_TIMEZONE=Asia/Kolkata
MOBILE_PUSH_COUNTDOWN_SEND_HOUR=9

# ── S3 / Object Storage ──────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000         # Internal service URL used by backend containers
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=passdetection-passports
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=10
S3_MAX_ATTEMPTS=3
S3_MAX_POOL_CONNECTIONS=64

# ── Durable Processing ───────────────────────────────────────
PROCESSING_BACKEND=celery
PROCESSING_JOB_MAX_ATTEMPTS=3
PROCESSING_JOB_TIMEOUT_SECONDS=45
PASSPORT_LOCAL_EXTRACTION_TIMEOUT_SECONDS=10
PROCESSING_WATCHDOG_DELAY_SECONDS=8
PROCESSING_WORKER_PING_TIMEOUT_SECONDS=1
# Celery active-queue inspection is bounded by the timeout above and cached in
# each API process for this duration; it is never performed per request.
PROCESSING_WORKER_READINESS_CACHE_SECONDS=15
ROI_FIELD_TIMEOUT_SECONDS=8
ROI_MAX_CONCURRENCY=4

# ── MRZ Extraction ───────────────────────────────────────────
MRZ_TIMEOUT_SECONDS=3

# Optional server-side Gemini verification after MRZ/OCR. Never expose this as NEXT_PUBLIC_*.
GOOGLE_API_KEY=
GEMINI_VERIFICATION_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_EDIT_FALLBACK_MODEL=gemini-3-pro-image
# Each model is called at most once per service attempt. The primary gets the
# first bounded window; a genuine provider/image failure can then use fallback.
GEMINI_IMAGE_EDIT_ATTEMPT_TIMEOUT_SECONDS=120
# Image models run in their own durable worker and are not held open through
# Cloudflare. This is the total cap across capacity wait, primary, and fallback.
GEMINI_IMAGE_EDIT_TIMEOUT_SECONDS=300
GEMINI_IMAGE_EDIT_JOB_MAX_ATTEMPTS=2
GEMINI_IMAGE_EDIT_MAX_CONCURRENCY=1
GEMINI_PROJECT_ALIAS=unconfigured
GEMINI_CONFIG_VERSION=v1
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_EXTRACTION_MAX_CONCURRENCY=32
GEMINI_VERIFICATION_MAX_CONCURRENCY=1
GEMINI_EXTRACTION_TIMEOUT_MS=30000
GEMINI_EXTRACTION_QUIET_PERIOD_MS=2000
GEMINI_RETRY_MAX_ATTEMPTS=3
GEMINI_PRIORITY_CAPACITY_CALIBRATED=false

# Email Integrations
# Keep every capability off until OAuth credentials, a dedicated token
# encryption key, migrations, and background workers are ready in that
# environment. Never reuse APP_SECRET_KEY as the token encryption key.
EMAIL_INTEGRATIONS_ENABLED=false
EMAIL_SYNC_ENABLED=false
EMAIL_ATTACHMENT_PROCESSING_ENABLED=false
EMAIL_LINK_RETRIEVAL_ENABLED=false
EMAIL_AUTO_ACTIONS_ENABLED=false
# AI analysis is a separate hard kill switch. Keep notifications disabled while
# evaluating analyses in shadow mode. Provider permissions remain read-only.
EMAIL_AI_ENABLED=false
EMAIL_AI_NOTIFICATIONS_ENABLED=false
EMAIL_AI_ANALYSIS_TIMEOUT_SECONDS=30
EMAIL_AI_MAX_INPUT_CHARS=16000
EMAIL_AI_MAX_OUTPUT_TOKENS=2048
EMAIL_AI_MAX_CANDIDATES=24
EMAIL_AI_LEASE_SECONDS=180
EMAIL_AI_MAX_ATTEMPTS=3
EMAIL_AI_MAX_MANUAL_RETRIES=3
EMAIL_AI_MAX_INFLIGHT=4
EMAIL_AI_AUTO_CONFIDENCE_THRESHOLD=0.9
EMAIL_AI_DEADLINE_CONFIDENCE_THRESHOLD=0.85
EMAIL_AI_DEADLINE_NOTIFICATION_WINDOW_DAYS=14
# Used only until account-level IANA timezones are configured.
EMAIL_AI_DEFAULT_TIMEZONE=Asia/Kolkata
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_TOKEN_ENCRYPTION_KEY_VERSION=1
# JSON map of prior key versions retained temporarily during rolling rotation.
EMAIL_TOKEN_DECRYPTION_KEYS={}
# Callback completion always redirects to this configured URL; it must never be
# derived from an inbound Host or forwarding header.
EMAIL_OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/email-integrations
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
# Microsoft Entra web application. Use tenant "common" to support both
# organizational Microsoft 365 and personal Outlook/Hotmail accounts.
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_REDIRECT_URI=
OUTLOOK_OAUTH_TENANT=common
EMAIL_OAUTH_STATE_TTL_SECONDS=600
EMAIL_SYNC_INTERVAL_SECONDS=15
EMAIL_SYNC_LEASE_SECONDS=300
EMAIL_SYNC_FULL_LOOKBACK_DAYS=7
EMAIL_SYNC_MAX_MESSAGES=500
EMAIL_ATTACHMENT_MAX_BYTES=26214400
EMAIL_PDF_MAX_PAGES=100
EMAIL_MAX_ARTIFACTS_PER_MESSAGE=100
# Scrubs stored body excerpts and completed staging objects after this period.
EMAIL_CONTENT_RETENTION_DAYS=30
# Reconciles only unreferenced email-owned objects older than this grace period.
EMAIL_STORAGE_ORPHAN_GRACE_HOURS=24
# Optional defense-in-depth scanner for email PDFs and uploads. When disabled,
# email PDFs still receive strict size, MIME, structure, encryption, and page
# validation before classification and matching. If enabled, this host must
# resolve from both the backend and email-worker containers.
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_HOST=localhost
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_SECONDS=2.0

# ── Rate Limiting ────────────────────────────────────────────
# Anonymous/non-dashboard API fallback, keyed by trusted client IP.
RATE_LIMIT_PER_MINUTE=60
# Authenticated dashboard actions are keyed independently per verified account.
DASHBOARD_RATE_LIMIT_PER_MINUTE=5000
# Atomic short-burst guard per verified account. This prevents one noisy staff
# session from consuming the shared office-Wi-Fi proxy lane.
DASHBOARD_RATE_LIMIT_PER_SECOND=50
DASHBOARD_RATE_LIMIT_BURST=150
# Protected passport/Visa image streams do not consume the dashboard action
# bucket. They retain this separate high-volume safety ceiling per account.
DASHBOARD_MEDIA_RATE_LIMIT_PER_MINUTE=30000
DASHBOARD_MEDIA_RATE_LIMIT_PER_SECOND=30
DASHBOARD_MEDIA_RATE_LIMIT_BURST=60
# Bounded in-memory thumbnail cache per backend worker (16 MiB by default).
DASHBOARD_THUMBNAIL_MAX_DIMENSION=320
DASHBOARD_THUMBNAIL_CACHE_MAX_BYTES=16777216
DASHBOARD_RATE_LIMIT_REQUIRE_REDIS=true

# ── Sentry (Observability) ───────────────────────────────────
SENTRY_DSN=                              # Leave empty to disable

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Global Connects Dashboard"
# Use this computer's LAN IPv4 address to share upload links on the same Wi-Fi.
NEXT_PUBLIC_APP_URL=https://192.168.1.100
# Use this only for Docker hot-reload mode, where Next.js runs directly on port 3000.
NEXT_PUBLIC_DEV_APP_URL=http://192.168.1.100:3000

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Enter the exact names of the two approved Meta templates before enabling sends.
WHATSAPP_WELCOME_TEMPLATE_NAME=
WHATSAPP_PASSPORT_LINK_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_NAME=reminder_v1
WHATSAPP_DOCUMENT_TEMPLATE_NAME=documents_v1
WHATSAPP_QR_TEMPLATE_NAME=qrcode_v1
# Approved Meta AUTHENTICATION template used only for GC App passenger OTP.
# The language must exactly match the approved template translation.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
WHATSAPP_APP_SECRET=
