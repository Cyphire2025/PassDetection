{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectApplicationBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__APPLICATION_BUCKET__"]
    },
    {
      "Sid": "ManageApplicationObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::__APPLICATION_BUCKET__/*"]
    }
  ]
}
