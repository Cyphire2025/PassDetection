  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-background-task": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.7",
    "expo-updates": "~57.0.11",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "^7.0.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "doctor": "npx expo-doctor",
    "native:sync": "expo prebuild",
    "release:validate-env": "cross-env GC_VALIDATE_PRODUCTION_PUBLIC_ENV=true expo config --type public",
    "release:prepare-ios": "npm run release:validate-env && expo prebuild --platform ios --no-install",
    "release:prepare-android": "npm run release:validate-env && expo prebuild --platform android --no-install",
    "android:apk": "npm run release:prepare-android && cross-env NODE_ENV=production android/gradlew.bat -p android --no-parallel \"-Dorg.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m\" assembleRelease",
    "android:aab": "npm run release:prepare-android && cross-env NODE_ENV=production android/gradlew.bat -p android --no-parallel \"-Dorg.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m\" bundleRelease"
  },
  "private": true
}
