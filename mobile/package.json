  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@expo/app-integrity": "57.0.1",
    "@noble/curves": "2.3.0",
    "@react-native-community/netinfo": "12.0.1",
    "@scure/base": "2.3.0",
    "@sentry/react-native": "7.11.0",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.15",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.12",
    "expo-battery": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-build-properties": "~57.0.13",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.12",
    "expo-updates": "~57.0.16",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-blob-util": "0.24.9",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "^7.0.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.2",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage && npm run coverage:check",
    "coverage:check": "node --test scripts/verify-critical-coverage.test.mjs && node scripts/verify-critical-coverage.mjs",
    "maintainability:check": "node --test scripts/verify-mobile-module-budgets.test.mjs && node scripts/verify-mobile-module-budgets.mjs",
    "e2e:contracts": "node --test scripts/validate-attendance-fixture-gate.test.mjs scripts/validate-maestro-environment.test.mjs scripts/validate-production-release-workflow.test.mjs scripts/verify-android-artifact.test.mjs scripts/verify-android-bundle.test.mjs && node scripts/validate-maestro-workspace.js",
    "doctor": "expo-doctor",
    "dependencies:check": "expo install --check && expo-doctor",
    "audit:runtime": "node scripts/verify-runtime-audit.js",
    "config:validate": "expo config --type public",
    "native:sync": "expo prebuild",
    "release:validate-env": "node scripts/validate-production-environment.js",
    "release:validate-links:ios": "cross-env GC_LINK_PLATFORM=ios node scripts/validate-verified-links.js",
    "release:validate-links:android": "cross-env GC_LINK_PLATFORM=android node scripts/validate-verified-links.js",
    "release:validate-android-push": "node scripts/validate-google-services.js",
    "release:validate-android-distribution": "node scripts/validate-android-distribution.js",
    "release:verify-android-apk": "node scripts/verify-android-artifact.js",
    "release:verify-android-aab": "node scripts/verify-android-bundle.js",
    "release:preflight-ios": "npm run dependencies:check && npm run release:validate-env && npm run release:validate-links:ios",
    "release:preflight-android": "npm run dependencies:check && npm run release:validate-env && npm run release:validate-android-push && npm run release:validate-android-distribution && npm run release:validate-links:android",
    "release:prepare-ios": "npm run release:preflight-ios && expo prebuild --clean --platform ios --no-install",
    "release:prepare-android": "npm run release:preflight-android && cross-env GC_VALIDATE_ANDROID_PUSH=true expo prebuild --clean --platform android --no-install",
    "android:apk": "npm run release:prepare-android && cross-env NODE_ENV=production android/gradlew.bat -p android --no-parallel \"-Dorg.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m\" assembleRelease",
    "android:aab": "npm run release:prepare-android && cross-env NODE_ENV=production android/gradlew.bat -p android --no-parallel \"-Dorg.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m\" bundleRelease"
  },
  "private": true
}
