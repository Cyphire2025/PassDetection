# Public application configuration. Never place server secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
EXPO_PUBLIC_APP_ENV=development
# Emulator-only local sample mode. Keep false for every normal/physical-device build.
EXPO_PUBLIC_DEMO_MODE=false
# Roll out together with MOBILE_REALTIME_ENABLED only after the API WebSocket
# proxy and Redis readiness checks pass. Cursor sync remains authoritative.
EXPO_PUBLIC_REALTIME_ENABLED=false
# Opt-in staged platform attestation. `monitor` preserves business workflows;
# `enforce` blocks only server-configured high-risk actions when verification
# fails. This project number is public provider identity, never a credential.
EXPO_PUBLIC_APP_INTEGRITY_MODE=disabled
EXPO_PUBLIC_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
# Non-secret native entitlement selector. Distribution builds use production;
# local development signing uses development.
GC_APP_ATTEST_ENVIRONMENT=development
# Public event-ingestion DSN. This is intentionally embedded in production
# binaries; never place the source-map upload token in an EXPO_PUBLIC_* value.
EXPO_PUBLIC_SENTRY_DSN=
# Public Ed25519 verification material for bounded offline authorization. Keep
# the JSON canonical (sorted key ids, no whitespace). The private key belongs
# only in the backend secret manager and must never use an EXPO_PUBLIC_* name.
EXPO_PUBLIC_OFFLINE_LEASE_ISSUER=passdetection-mobile-offline
EXPO_PUBLIC_OFFLINE_LEASE_AUDIENCE=gc-mobile-offline
EXPO_PUBLIC_OFFLINE_LEASE_PUBLIC_KEYS_JSON={"dev-20260820-f6b34c61":"EvvYtWXYgnKK1znyJHucbeQK5VFvJA8oG5Uwkuv4pFE"}
# Required in production so physical devices can register for push notifications.
# Add owner and the canonical Updates URL as well when enabling EAS Update.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EXPO_OWNER=
EXPO_PUBLIC_UPDATES_URL=
# Build-time public verification certificate for signed EAS Updates. Keep the
# private signing key outside the repository and outside the application build.
EXPO_UPDATES_CODE_SIGNING_CERTIFICATE=
# Android release builds also require a protected Firebase client config path.
# Never commit the real file; use an EAS file secret or a local ignored path.
GOOGLE_SERVICES_JSON=
# Fail-closed Universal Link/App Link release checks. These identifiers are not
# secrets, but must match the protected production signing identities.
GC_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
GC_APPLE_TEAM_ID=
# Build-only source-map upload configuration. Store SENTRY_AUTH_TOKEN as a
# protected EAS secret; it must never be bundled into Expo `extra`.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
