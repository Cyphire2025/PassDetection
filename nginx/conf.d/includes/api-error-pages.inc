error_page 413 = @api_error_413;
error_page 414 = @api_error_414;
error_page 431 = @api_error_431;
error_page 500 = @api_error_500;
error_page 502 = @api_error_502;
error_page 503 = @api_error_503;
error_page 504 = @api_error_504;
