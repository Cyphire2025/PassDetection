import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
import { beforeEach, describe, expect, it, vi } from "vitest";
import type { QualifierSelectionState, UploadLinkResponse } from "@/features/passports/api/upload-links.api";
import { DEFAULT_UPLOAD_CONFIGURATION } from "@/features/passports/types/upload-configuration";
import type { DraftQualifierInputs } from "../services/draft-input-contract";
import { FreshQualifier } from "./fresh-qualifier";

const transport = vi.hoisted(() => ({ getQualifierSelection: vi.fn() }));
vi.mock("@/features/passports/api/public-upload-link.api", () => ({ publicUploadLinkApi: transport }));
const proof = "a".repeat(43), nextProof = "b".repeat(43);
const group = (token = "group-a") => ({
  token, qualifier_relation_options: [{ code: "spouse", label: "Spouse" }],
  upload_configuration: { ...DEFAULT_UPLOAD_CONFIGURATION, qualifier_relation_list_enabled: true, qualifier_relation_other_enabled: true },
}) as UploadLinkResponse;
function state(selectionToken: string | null = proof): DraftQualifierInputs {
  return {
    pending: false,
    payload: { passport_fields: {}, current_details: {}, custom_answers: {}, custom_detail_answers: {}, collection: { acquisition_mode: "file", submission_mode: "single", qualifier_selection_token: selectionToken } },
    collection: vi.fn(),
    serialized: async <T,>(operation: (signal: AbortSignal) => Promise<T>) => operation(new AbortController().signal),
    api: { qualifier: vi.fn().mockResolvedValue({ selection_token: nextProof }) },
  };
}
function selection(patch: Partial<QualifierSelectionState> = {}): QualifierSelectionState {
  return { is_self: false, relation_code: "other", relation_label: "Cousin", selected_at: "2026-01-01T00:00:00Z", expires_at: "2099-01-01T00:00:00Z", status: "active", submission_id: null, ...patch };
}
function deferred<T>() {
  let resolve!: (value: T) => void;
  const promise = new Promise<T>(done => { resolve = done; });
  return { promise, resolve };
}
beforeEach(() => {
  transport.getQualifierSelection.mockReset();
  transport.getQualifierSelection.mockResolvedValue(selection());
});

describe("fresh qualifier selection restoration", () => {
  it("keeps new selections local until an explicit save and supports a listed relationship", async () => {
    const draft = state(null);
    render(<FreshQualifier state={draft} group={group()} />);
    expect(transport.getQualifierSelection).not.toHaveBeenCalled();
    expect(draft.api.qualifier).not.toHaveBeenCalled();
    fireEvent.change(screen.getByRole("combobox"), { target: { value: "spouse" } });
    fireEvent.click(screen.getByRole("button", { name: "Continue" }));
    await waitFor(() => expect(draft.collection).toHaveBeenCalledWith({ qualifier_selection_token: nextProof }));
    expect(draft.api.qualifier).toHaveBeenCalledWith({ is_self: false, relation_code: "spouse" }, expect.any(AbortSignal));
    expect(transport.getQualifierSelection).not.toHaveBeenCalled();
  });

  it("restores saved Other before editing and saves the new draft proof", async () => {
    const draft = state();
    render(<FreshQualifier state={draft} group={group()} />);
    expect(transport.getQualifierSelection).not.toHaveBeenCalled();
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await waitFor(() => expect(screen.getByRole("textbox", { name: "Specify relationship" })).toHaveValue("Cousin"));
    expect(screen.getByRole("radio", { name: /Other relationship/ })).toHaveAttribute("aria-checked", "true");
    expect(transport.getQualifierSelection).toHaveBeenCalledWith("group-a", proof, expect.any(AbortSignal));
    fireEvent.change(screen.getByRole("textbox", { name: "Specify relationship" }), { target: { value: "Colleague" } });
    fireEvent.click(screen.getByRole("button", { name: "Continue" }));
    await waitFor(() => expect(draft.collection).toHaveBeenCalledWith({ qualifier_selection_token: nextProof }));
    expect(draft.api.qualifier).toHaveBeenCalledWith({ is_self: false, relation_code: "other", other_relation: "Colleague" }, expect.any(AbortSignal));
  });

  it.each([
    { choice: selection({ is_self: true, relation_code: null, relation_label: "Self" }), radio: /^Self/, code: "" },
    { choice: selection({ relation_code: "spouse", relation_label: "Spouse" }), radio: /Choose from list/, code: "spouse" },
  ])("restores the existing $choice.relation_label path", async ({ choice, radio, code }) => {
    transport.getQualifierSelection.mockResolvedValueOnce(choice);
    render(<FreshQualifier state={state()} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await waitFor(() => expect(screen.getByRole("radio", { name: radio })).toHaveAttribute("aria-checked", "true"));
    expect(screen.getByRole("combobox")).toHaveValue(code);
    expect(screen.getByRole("textbox", { name: "Specify relationship" })).toHaveValue("");
  });

  it("retains a valid proof after a failed read and supports retry without disclosing the failure", async () => {
    const draft = state();
    transport.getQualifierSelection.mockRejectedValueOnce(new Error(`Private failure ${proof}`));
    render(<FreshQualifier state={draft} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await expect(screen.findByRole("alert")).resolves.toHaveTextContent("restore");
    expect(screen.queryByText(new RegExp(proof))).not.toBeInTheDocument();
    expect(draft.payload?.collection?.qualifier_selection_token).toBe(proof);
    expect(draft.collection).not.toHaveBeenCalled();
    expect(draft.api.qualifier).not.toHaveBeenCalled();
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await waitFor(() => expect(screen.getByRole("textbox", { name: "Specify relationship" })).toHaveValue("Cousin"));
    expect(transport.getQualifierSelection).toHaveBeenCalledTimes(2);
  });

  it.each([
    selection({ status: "expired" }), selection({ status: "consumed" }),
    selection({ expires_at: "2020-01-01T00:00:00Z" }),
  ])("does not hydrate or autosave an inactive relationship %#", async choice => {
    const draft = state();
    transport.getQualifierSelection.mockResolvedValueOnce(choice);
    render(<FreshQualifier state={draft} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await expect(screen.findByRole("alert")).resolves.toHaveTextContent("no longer active");
    expect(screen.getByRole("textbox", { name: "Specify relationship" })).toHaveValue("");
    expect(screen.getByRole("radio", { name: /Other relationship/ })).toHaveAttribute("aria-checked", "false");
    expect(draft.collection).not.toHaveBeenCalled();
    expect(draft.api.qualifier).not.toHaveBeenCalled();
  });

  it.each([
    { transition: "group", nextGroup: "group-b", savedProof: proof },
    { transition: "proof", nextGroup: "group-a", savedProof: nextProof },
  ])("hides the previous choice immediately on a $transition transition", async ({ nextGroup, savedProof }) => {
    const first = state();
    const view = render(<FreshQualifier state={first} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await waitFor(() => expect(screen.getByDisplayValue("Cousin")).toBeVisible());
    view.rerender(<FreshQualifier state={state(savedProof)} group={group(nextGroup)} />);
    expect(screen.queryByDisplayValue("Cousin")).not.toBeInTheDocument();
    expect(screen.getByText("Qualifier relationship saved")).toBeVisible();
    expect(transport.getQualifierSelection).toHaveBeenCalledTimes(1);
  });

  it("ignores a late response after leaving and returning to the same owner", async () => {
    const old = deferred<QualifierSelectionState>();
    transport.getQualifierSelection.mockReturnValueOnce(old.promise);
    const view = render(<FreshQualifier state={state()} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    const signal = transport.getQualifierSelection.mock.calls[0][2] as AbortSignal;
    expect(screen.getByRole("button", { name: "Change" })).toBeDisabled();
    view.rerender(<FreshQualifier state={state(nextProof)} group={group("group-b")} />);
    expect(signal.aborted).toBe(true);
    view.rerender(<FreshQualifier state={state()} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    await waitFor(() => expect(screen.getByDisplayValue("Cousin")).toBeVisible());
    fireEvent.change(screen.getByRole("textbox", { name: "Specify relationship" }), { target: { value: "Colleague" } });
    await act(async () => { old.resolve(selection({ relation_label: "Late private value" })); });
    expect(screen.getByRole("textbox", { name: "Specify relationship" })).toHaveValue("Colleague");
    expect(screen.queryByDisplayValue("Late private value")).not.toBeInTheDocument();
  });

  it("aborts a pending read when its component unmounts", async () => {
    const pending = deferred<QualifierSelectionState>(), draft = state();
    transport.getQualifierSelection.mockReturnValueOnce(pending.promise);
    const view = render(<FreshQualifier state={draft} group={group()} />);
    fireEvent.click(screen.getByRole("button", { name: "Change" }));
    const signal = transport.getQualifierSelection.mock.calls[0][2] as AbortSignal;
    view.unmount();
    expect(signal.aborted).toBe(true);
    await act(async () => { pending.resolve(selection()); });
    expect(draft.collection).not.toHaveBeenCalled();
    expect(draft.api.qualifier).not.toHaveBeenCalled();
  });

  it("does not replace the private proof when a dispatched save completes after cancellation", async () => {
    const pending = deferred<{ selection_token: string }>(), draft = state(null);
    const controller = new AbortController();
    draft.serialized = async operation => operation(controller.signal);
    vi.mocked(draft.api.qualifier).mockReturnValueOnce(pending.promise);
    render(<FreshQualifier state={draft} group={group()} />);
    fireEvent.change(screen.getByRole("textbox", { name: "Specify relationship" }), { target: { value: "Cousin" } });
    fireEvent.click(screen.getByRole("button", { name: "Continue" }));
    expect(draft.api.qualifier).toHaveBeenCalledTimes(1);
    controller.abort();
    await act(async () => { pending.resolve({ selection_token: nextProof }); });
    expect(draft.collection).not.toHaveBeenCalled();
  });
});
