"use client";

import { Button } from "@/components/ui/button";
import type { UploadLinkResponse } from "@/features/passports/api/upload-links.api";
import { useQualifierSelectionEditor } from "../hooks/use-qualifier-selection-editor";
import type { DraftQualifierInputs } from "../services/draft-input-contract";
import { getUploadFlowSettings } from "../services/configured-upload";
import { buildQualifierSelectionRequest } from "../services/relation-qualifier";
import { RelationQualifierStep } from "./relation-qualifier-step";

export function FreshQualifierEditor({ state, group }: { state: DraftQualifierInputs; group: UploadLinkResponse }) {
  const savedToken = state.payload?.collection?.qualifier_selection_token;
  const editor = useQualifierSelectionEditor(group.token, savedToken);
  const config = getUploadFlowSettings(group).uploadConfig;
  const busy = state.pending || editor.restoring;
  const save = () => {
    const choice = buildQualifierSelectionRequest(editor.path, editor.relation, group.qualifier_relation_options, editor.other, {
      listEnabled: config.qualifier_relation_list_enabled,
      otherEnabled: config.qualifier_relation_other_enabled,
    });
    if (!choice) return;
    void state.serialized(async signal => {
      const result = await state.api.qualifier(choice, signal);
      signal.throwIfAborted();
      state.collection({ qualifier_selection_token: result.selection_token });
      editor.close();
    }, true).catch(() => undefined);
  };

  if (savedToken && !editor.editing) {
    return <div className="rounded-xl bg-blue-50 p-3 text-sm text-blue-900">
      <div className="flex items-center justify-between gap-3">
        <span>Qualifier relationship saved</span>
        <Button type="button" variant="secondary" disabled={busy} isLoading={editor.restoring} onClick={() => { void editor.restore(); }}>Change</Button>
      </div>
      {editor.error && <p role="alert" className="mt-2 text-red-700">{editor.error}</p>}
    </div>;
  }
  return <div className="rounded-2xl border border-slate-200 bg-white p-5">
    {editor.error && <p role="alert" className="mb-3 text-sm text-red-700">{editor.error}</p>}
    <RelationQualifierStep
      path={editor.path}
      relationCode={editor.relation}
      otherRelation={editor.other}
      listEnabled={config.qualifier_relation_list_enabled}
      otherEnabled={config.qualifier_relation_other_enabled}
      options={group.qualifier_relation_options}
      isSaving={busy}
      onPathChange={editor.setPath}
      onRelationChange={editor.setRelation}
      onOtherRelationChange={editor.setOther}
      onContinue={save}
    />
  </div>;
}
